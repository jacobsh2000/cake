# Copy to .env.local and fill in. Never commit .env.local — it is
# gitignored, and the service role key below bypasses every RLS policy.

# --- Clerk (auth) -------------------------------------------------
# Dashboard → API Keys. Development keys start pk_test_ / sk_test_;
# Production keys require a verified custom domain and are a separate
# user pool, so admin roles must be re-tagged after switching.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Supabase (database only, not auth) ---------------------------
# Settings → API. The service role key is server-only: it is read
# exclusively by lib/supabaseAdmin.js inside API routes, and must
# never be exposed to the browser or prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (transactional email) ---------------------------------
# Used by lib/sendEmail.js via Resend's REST API (no SDK dependency).
# If RESEND_API_KEY is unset, sends are skipped and logged rather than
# failing the request. Until the domain is verified in Resend, the
# shared onboarding@resend.dev sender can only deliver to the Resend
# account's own email address.
RESEND_API_KEY=
EMAIL_FROM="Columbus Cake Celebrations <onboarding@resend.dev>"

# --- Scheduled job (Vercel Cron) ----------------------------------
# CRON_SECRET authenticates the nightly job at /api/cron/daily. Vercel
# sends it as `Authorization: Bearer <secret>` automatically once the
# variable is set in the project's environment variables. The route
# refuses to run when it is missing, so a misconfiguration fails closed
# rather than leaving a public email-sending endpoint open. Generate
# one with: openssl rand -hex 32
CRON_SECRET=

# Where the daily digest goes. Unset means the digest is skipped —
# recorded as a successful no-op, not a failure.
ADMIN_DIGEST_EMAIL=

# Used to build the "open the admin dashboard" link in emails.
APP_URL=https://your-app.vercel.app
